# ==========================================
# SmartMarks AI - Environment Configuration
# ==========================================

# Server Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security & Session
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (MongoDB Atlas or Local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=smartmarks_ai

# OCR Configuration
# Options: RAPID_OCR, PADDLE_OCR, MOCK_OCR
OCR_ENGINE=RAPID_OCR
OCR_CONFIDENCE_THRESHOLD=0.65

# Microsoft Azure AD / MSAL Integration (Optional for local testing, required for OneDrive export)
AZURE_CLIENT_ID=your_azure_client_id_here
AZURE_TENANT_ID=common
AZURE_CLIENT_SECRET=your_azure_client_secret_here
AZURE_REDIRECT_URI=http://localhost:5173/auth/callback
AZURE_SCOPES=Files.ReadWrite,User.Read,offline_access

# Storage
UPLOAD_DIR=temp_scans
EXPORT_DIR=generated_exports
